# ==========================================
# LottoMind Environment Configuration
# ==========================================

# Application
PROJECT_NAME="LottoMind"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL with asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/lottomind"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lottomind
POSTGRES_PORT=5432

# Alibaba DashScope / Qwen API
DASHSCOPE_API_KEY=""
DASHSCOPE_BASE_URL="https://maas.qwencloudapi.com/compatible-mode/v1"
QWEN_MODEL="qwen-max"

# Budget Configuration (ZAR)
DEFAULT_MONTHLY_BUDGET=200.00
COST_PER_BOARD=10.00
TOTAL_MONTHLY_BOARDS=20
BUDGET_CYCLE_ROLLOVER_DAY=25

# Alerts & Telegram OTP (Phase 1.2 & 5.5)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"
DISCORD_WEBHOOK_URL=""

# Authentication & Session Security (Directives 25-28)
JWT_SECRET_KEY="generate_a_secure_random_hex_key_here"
JWT_ALGORITHM="HS256"
JWT_EXPIRY_HOURS=24
SESSION_COOKIE_NAME="lottomind_session"

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "https://lotto-num-gen-33fe8.uc.r.appspot.com"]
